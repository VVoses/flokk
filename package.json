{
  "name": "flokk",
  "private": true,
  "license": "UNLICENSED",
  "description": "Lead a flock of sparrows through a year. Zero runtime dependencies; these are dev tools only.",
  "scripts": {
    "lint": "node tools/lint.mjs",
    "format": "prettier --write \"js/*.js\" \"css/*.css\" \"tools/*.{cjs,mjs}\" index.html",
    "check": "sh tools/check.sh",
    "check:polish": "node tools/polish_check.cjs",
    "check:seasons": "node tools/transition_check.cjs"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.0.0"
  }
}
